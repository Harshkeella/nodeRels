# Copy to .env and fill in. The backend loads it automatically -- no export step.
#
# GROQ_API_KEY is the only one the app needs to write a deck. The photo providers are
# optional and independent. Wikimedia Commons works without a key; these add more stock
# choices when configured.

# --- deck writer (required for generation) ---
GROQ_API_KEY=            # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TPM=8000             # your Groq tier's tokens-per-minute. Free tier is 8000.

# --- providers (free tiers, no card) ---
UNSPLASH_ACCESS_KEY=      # https://unsplash.com/developers   50 req/hr demo, 5000/hr prod
PEXELS_API_KEY=           # https://www.pexels.com/api/       200 req/hr
PIXABAY_API_KEY=          # https://pixabay.com/api/docs/     100 req/min

# --- retrieval ---
IMG_PER_QUERY=8           # candidates per provider per query
IMG_MAX_CANDIDATES=100    # ranked pool ceiling per slide
IMG_HTTP_TIMEOUT=12
IMG_SLIDE_BUDGET=45       # seconds for one slide, then return what we have

# --- licensing: only these ever reach the ranker ---
IMG_ALLOWED_LICENSES=unsplash,pexels,pixabay,cc0,pdm,cc-by,cc-by-sa

# --- final score weights (need not sum to 1; they are normalised) ---
W_SEMANTIC=0.50
W_QUALITY=0.22
W_ASPECT=0.18
W_DIVERSITY=0.10

# --- quality sub-weights ---
WQ_RESOLUTION=0.40
WQ_SHARPNESS=0.25
WQ_EXPOSURE=0.20
WQ_COLOUR=0.15
WQ_AESTHETIC=0.0          # leave at 0 until an aesthetic model is plugged in

# --- tuning ---
IMG_ASPECT_GAMMA=1.5      # higher = harsher crop-loss penalty
IMG_DUP_HAMMING=8         # dHash distance counted as the same picture (0-64)
IMG_MIN_BYTES=8000
IMG_CACHE=                # defaults to backend/image_engine/cache
# Private integrated MCP server: uvicorn backend.integrated:app --host 127.0.0.1 --port 8101
AGENT_SHARED_SECRET=
AGENT_STORAGE_DIR=./agent-storage
AGENT_WORKERS=1
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_MAX_SAVED_PER_USER=100
ARTIFACT_MIN_FREE_BYTES=1073741824
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,deck-agent:8101
# Free cross-platform rendering. Install LibreOffice; set only if not on PATH.
LIBREOFFICE_PATH=
# Online voice retries and falls back to Windows SAPI / espeak-ng when unavailable.
# Set local for fully offline narration (voice quality depends on installed voices).
VIDEO_TTS_ENGINE=edge
